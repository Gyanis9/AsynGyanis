# AsynGyanis 的生产配置样例（ReferenceServer --config 可直接加载）。
#
# 抄用方式：复制到部署机（systemd 单元里是 /etc/asyngyanis/asyngyanis.yaml），按现场改。
# 样例里凡是口令/密钥/私钥的键都没有写值（注释掉或留空说明位置）——AccessKey 一类只从
# 环境变量读，任何情况下都不要把它们写进版本库或镜像。
#
# 监听地址与端口不在本文件里：`--host` / `--port` 只能从命令行给，而 `--host` 的默认值是
# localhost。容器里跑必须显式给 `--host 0.0.0.0`——`docker run 镜像 --config /cfg/x.yaml` 会
# 整段替换镜像的 CMD，连带把 CMD 里那个 `--host 0.0.0.0` 一起丢掉，于是服务只听回环、
# 从容器外一条也连不上（端口映射看着是通的，症状只是超时）。
#
# 两类键的处置不同，读配置时就能分辨：
#   · server / acme 段：未知键当场拒（拼错不会被静默忽略）；
#   · logging 段：未知字段只打一行 stderr 诊断——sink 的字段集按类型多态，为一个多余字段
#     丢掉整条 sink 比现状更伤。
# 每一项的默认值与「配错了会怎样」见 docs/配置与可观测性.md 的「限额与背压」。

server:
  # 整机并发连接上限；多进程部署里这是整机口径，装配时按「worker 进程数 × 每进程监听器数」
  # 摊到每台。显式写 0 = 不限（把连接表交给对端，要写就写下理由）。
  maximum_connections: 4096
  # 单个来源 IP 的并发上限；共享出口（运营商 NAT、企业代理）要按实测并发抬高，别关掉。
  # 0 = 不限。
  maximum_connections_per_ip: 256
  # 在途请求正文总量上限（整机字节数），0 = 不设这道账。开了之后超预算的新请求回 503。
  memory_budget_bytes: 0
  # 打开运维端点：/metrics、/healthz、/readyz、/debug/loops、/debug/connections，
  # 以及配了下面那个令牌时才注册的 /debug/log-level（改日志等级是写操作：没闸门就不留这个入口）。
  expose_metrics: true
  # 运维端点的 Bearer 令牌。不要把现场令牌写进本文件后提交；部署时把这一行取消注释并填入
  # 现场值（令牌只能写在配置文件里，命令行上的令牌会进 shell 历史与进程列表）。
  # 不配 = /metrics、/debug/loops 与 /debug/connections 都不鉴权，且 /debug/log-level 不注册；
  # /healthz 与 /readyz 刻意不查令牌（探针要能被编排器无凭据访问，给探针加闸的结局是探针被人关掉）。
  # ops_bearer_token: <现场值>
  # 运维端点另起的管理口；0 = 端点留在业务口上。多进程时实际端口是这里加进程序号。
  metrics_port: 9091
  # 管理口监听地址；默认只听回环。写成 0.0.0.0 前先确认上面配了令牌。
  metrics_address: 127.0.0.1
  # 每条请求记一行访问日志（method/uri/status/duration_ms/bytes/request_id/client/proto/tls/route），
  # 默认开。写进根日志器（Info），因此跟着上面 logging 段 root 的 sink 与等级走：root 抬到 warn
  # 以上就没有访问日志了。要按来源排障、或让采集端（Filebeat/vector）看得见流量，别关它。
  # 关掉：access_log: false
  access_log: true

  # 单条请求的处理器时限（毫秒），0 = 不设。h2 上这一格是唯一能表达「这一条流的处理器跑了多久」
  # 的钟——连接级的 write/idle 时限到期会把整条连接连同兄弟流一起收掉；这里到点只把协作式取消交给
  # 业务、把这一条响应改写成 504，同连接其它流照常完成。
  # 两点要知道：① 不配合取消、又永远不返回的处理器拿不到这条 504（改写发生在业务返回那一刻），
  # 要硬收口得让处理器可中断；② 它不像 limits 那样能 SIGHUP 换代——装不装这层中间件在 start() 前
  # 就定了，改这格要重启。
  # handler_timeout_ms: 5000

  # 加密策略。整段可以都不写：不写就是库的既有档位（服务端最低 TLS 1.2、安全等级 2、那份显式
  # 排除弱算法的套件列表），与加这一段之前逐字相同。每一格都是「不改代码就收不住」的那类加固项。
  # 套件串与曲线名的合法性由 OpenSSL 判定（它随发行版配置变化），写错时启动当场退出并把那份原文
  # 与出错的那一项打出来——不会静默按默认档跑，因为半生效的 TLS 策略比启动失败危险得多。
  tls:
    # 下限只认 TLS1.2 / TLS1.3（大小写都认）。更低的两档由 RFC 8996 列为废弃，这里既不接受也不给
    # 取值：写成 TLS1.1 或 SSLv3 读配置当场拒。把上限压到 TLS1.2 而同时开着 --h3，QUIC 那一路会
    # 拒绝启动（QUIC 只跑 TLS 1.3，RFC 9001）。
    minimum_protocol_version: TLS1.2
    # TLS 1.2 及以下的套件串（OpenSSL 语法，冒号分隔）。写窄了会把老客户端拒在握手之外，症状是
    # 「一部分用户连不上」而服务端只有一条握手失败计数。
    # cipher_list: ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384
    # TLS 1.3 套件串。留空交给 OpenSSL 默认。
    # tls13_cipher_suites: TLS_AKE_WITH_AES_256_GCM_SHA384:TLS_AKE_WITH_CHACHA20_POLY1305_SHA256
    # 命名曲线/组，冒号分隔。写了不存在的名字同样是启动即退出。
    # supported_groups: X25519:secp384r1
    # OpenSSL 安全等级，只认 0-5（默认 2：拒 1024 位以下的 RSA/DH 与 SHA-1 签名）。调 0 是什么
    # 签名的证书都收，调 5 会把 2048 位以下的 RSA 全部拒掉——两侧都只在握手期暴露，改前先想清楚
    # 要接哪些对端。
    # security_level: 2
    # 双向 TLS：开关 + 信任锚 + 点名名单。require_client_certificates 写 true 而下面两个 CA
    # 一个都没给 → 读配置当场拒（那种状态在握手里的形态是每条连接都失败，而不是「退化成不校验」）。
    # require_client_certificates: false
    # certificate_authority_file: /etc/asyngyanis/ca.pem
    # certificate_authority_path: /etc/asyngyanis/certs    # 需要 openssl c_rehash 过的哈希目录
    # 证书链校验深度，必须 ≥1（0 意味着连对端那一张都不许验，等于每条握手必失败）。
    # verify_depth: 4
    # 吊销检查：给了 CRL 文件才算启用（只支持单个文件，PEM/DER 都行，一份文件里可以放多张 CRL）。
    # 启用它却没有覆盖到发证 CA 的列表时，握手一条也不成——这个方向是刻意的：「列表没同步到就当
    # 没吊销」比「同步断了先拒掉」危险。
    # revocation_list_file: /etc/asyngyanis/ca.crl
    # 只查对端那一张，还是链上每张（含中间 CA）都查。写 true 而没给 revocation_list_file → 读配置当场拒。
    # revocation_covers_whole_chain: false
    # 会话票据。关掉后 --ticket-key 那几行随之失去作用，多进程间也就无从共享恢复能力（合规要求
    # 关掉恢复时才是这个）。
    # session_tickets: true
    # 对端证书指纹名单：每项 64 位小写十六进制（`openssl x509 -noout -fingerprint -sha256` 取得），
    # 不合规的取值在启动时被拒并点名那一项。名单是「链验通之上再点名」，不替代链校验，也只在
    # require_client_certificates 打开时才有对象可查——两处不配套时读配置当场拒（与 mTLS 没给 CA 同口径）。
    # allowed_peer_sha256_fingerprints:
    #   - 00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

  # 连接级限额（时间与单连接请求条数）。0 一律表示关闭对应保护。
  # SIGHUP / 文件监听重载会整体换新一代限额，只影响此后新建的连接，已建立的连接不打断。
  limits:
    # 两次请求之间收不到新字节的容忍时长（keep-alive 空闲与 WebSocket 帧间空闲）
    idle_timeout_ms: 75000
    # 相邻两次成功读取之间的最长空闲（慢速攻击防线）
    read_timeout_ms: 60000
    # 从一条请求的首字节到请求头收齐的总预算；0 = 关闭。正文没有对应的总时限
    request_header_timeout_ms: 30000
    # 响应产出预算：处理器执行与等待可写的最长时长（慢消费者与长处理器防线）
    write_timeout_ms: 60000
    # HTTP/2 握手期等对端 ACK 本端 SETTINGS 的时长
    settings_acknowledgement_timeout_ms: 10000
    # WebSocket 心跳：发出 Ping 后等 Pong 的时长；0 = 不设这项保护
    web_socket_pong_timeout_ms: 0
    # 单连接最多处理的请求条数，达到后回完当前响应即收口；0 = 不限
    maximum_requests_per_connection: 1000

  # 单条报文的内存上限（三条协议通道同一把尺）。0 一律表示关闭该项保护。
  parser_limits:
    maximum_uri_length: 8192
    maximum_header_field_name_length: 256
    maximum_header_field_value_length: 8192
    maximum_header_count: 100
    maximum_header_block_length: 65536
    maximum_body_size: 8388608
    maximum_chunk_size_line_length: 1024
    # 入站 WebSocket 一条消息的上限：分片重组后与 permessage-deflate 解压后同用这一把尺
    maximum_websocket_message_size: 8388608

  # 令牌桶限流；requests_per_second = 0 表示不限流（默认值刻意是 0：给默认值会误杀真实用户）。
  # burst_capacity 是瞬时突发量，开限流时必须 >= 1。
  rate_limit:
    requests_per_second: 0.0
    burst_capacity: 1.0

# 日志：global_level 与 sinks。未配置前 root 是 Trace 且零 sink（全部丢弃），因此生产必须配。
logging:
  global_level: info
  # loggers 是「日志器名 → 它的字段」的映射，不是列表：写成 `- level: …` 会被整段跳过
  # （只在 stderr 打一行「loggers 不是对象」），于是下面的 sink 一个都不生效。root 是根日志器。
  loggers:
    root:
      level: info
      sinks:
        # 控制台：容器/systemd 采集用。color=false 让重定向后的日志不带 ANSI 转义。
        - type: console
          color: false
          level: info
        # 异步包一层滚动文件：满队列按 drop 丢并计数（asyn_http_log_dropped_events_total，
        # 那是「日志系统自己来不及」的信号，不是业务错误）。
        # directory 写绝对路径：相对路径的锚点是本配置文件所在的目录（不是进程工作目录，
        # 见 LoggerConfigLoader::resolveLogPath），而 systemd 那份配置住在 /etc/asyngyanis/ ——
        # 写 `logs` 就会去建 /etc/asyngyanis/logs，专用账号在 /etc 下建不动，启动即抛带路径的异常。
        # /var/lib/asyngyanis 由镜像的 install -d 与单元里的 StateDirectory= 各自备好并归属专用账号。
        - type: async
          queue_size: 8192
          overflow_policy: drop
          wrapped:
            type: rolling_file
            base_filename: asyngyanis.log
            directory: /var/lib/asyngyanis/logs
            # size / daily / hourly；size 档配合 max_size_mb 与 max_backup
            policy: size
            max_size_mb: 100
            max_backup: 10
            # 逐行同步（文件族 sink 在配置这一层的默认就是开）：写完就交给操作系统，tail -f、
            # Filebeat/vector 这类采集与崩溃后的取证才读得到。写 immediate_flush: false 换回
            # 「攒进流缓冲、由刷新或收口统一交出」，省一点系统调用，代价是运行期文件可能长时间
            # 是 0 字节——开着日志采集的部署别关它。

# 链路追踪（OTLP 推送 / 文件落盘）。enabled=false 时其余取值不校验，但未知键仍会拒。
tracing:
  enabled: false
  service_name: asyngyanis
  service_version: "0.0.0"
  sample_ratio: 0.1
  pending_span_count: 2048
  batch_span_count: 512
  export_interval_ms: 5000
  otlp:
    endpoint: http://127.0.0.1:4318
    timeout_ms: 3000
    headers: {}
  file:
    # 同样写绝对路径，理由与上面 logging 段的 directory 一致（相对路径的锚点难记，且 /etc 下写不动）。
    path: /var/lib/asyngyanis/logs/spans.jsonl

# 日志推给 OTLP 采集端（/v1/logs）。段缺失或 enabled=false 即关着；开了必须给服务名与地址。
# 与 metrics 段不同，日志是批语义：有界队列、失败重试、溢出与收尾丢弃都计数（日志丢了就是丢了）。
# 记录里会带日志上下文字段（trace_id/span_id/request_id）与 logger.name/thread.id。
log_export:
  enabled: false
  service_name: asyngyanis
  service_version: "0.0.0"
  export_interval_ms: 5000
  shutdown_timeout_ms: 3000
  maximum_pending_records: 4096
  maximum_batch_records: 256
  otlp:
    endpoint: http://127.0.0.1:4318/v1/logs
    timeout_ms: 3000
    headers: {}

# 读数推给 OTLP 采集端（无需抓取端）。段缺失或 enabled=false 即关着；
# 空快照周期直接跳过、失败不补发（下个周期是全量最新值，不是可靠队列）。
metrics:
  enabled: false
  service_name: asyngyanis
  service_version: "0.0.0"
  export_interval_ms: 15000
  otlp:
    endpoint: http://127.0.0.1:4318
    timeout_ms: 3000
    headers: {}

# 证书自动化（ACME）。默认整段关着。要开时把下面整段取消注释并填现场值；
# AccessKey 不认配置文件，只从环境变量读：
#   ASYN_ACME_DNS_ACCESS_KEY_ID / ASYN_ACME_DNS_ACCESS_KEY_SECRET
#
# acme:
#   enabled: true
#   directory_url: https://acme-v02.api.letsencrypt.org/directory
#   domains: [example.com, www.example.com]
#   certificate_file: /etc/asyngyanis/tls/fullchain.pem
#   private_key_file: /etc/asyngyanis/tls/privkey.pem
#   account_key_file: /etc/asyngyanis/acme/account.key
#   account_state_file: /etc/asyngyanis/acme/account.json
#   contact_email: ops@example.com
#   tos_accepted: true
#   challenge: dns-01            # http-01 或 dns-01
#   renew_before_expiry_days: 30
#   renewal_check_interval_minutes: 720
#   dns:
#     provider: aliyun
#     domain: example.com
#     record_ttl_seconds: 600    # 下限 600；配小了在读配置时就拒
