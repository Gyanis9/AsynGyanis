/.idea/
/build/

# Conan 的 test_package 会在自己目录下生成构建目录与 CMakeUserPresets.json，
# 它们是本机产物（路径里带着本机 Conan 缓存位置），不该进仓库
/packaging/conan/test_package/build/
/packaging/conan/test_package/CMakeUserPresets.json
/bin/
__pycache__/

# scripts/fuzz-net.sh 的产物：clang-cl 编出的目标文件、模糊可执行体与撞出来的样本
# （样本要人工判读后搬进 gtest 用例常驻，不该以「一堆没看过的 crash 文件」的形式留在树里）
/.fuzz/

# vcpkg 清单模式在仓库根装出来的依赖树与缓存是本机产物（路径里带着本机 vcpkg 根目录），
# 不该进仓库；消费方冒烟测试的构建目录同理
/vcpkg_installed/
/packaging/vcpkg/smoke/build/

# SBOM 生成产物（scripts/generate-sbom.py 的输出目录）：每次构建可重生成，不进仓库
/sbom/

# archify 的工作目录：候选变体、finalize 收据、浏览器证据与视口截图。
# 交付物在 assets/diagrams/（HTML 正文 + candidate JSON + 目检过的浅色 PNG），这里只留下可重生成的本机证据
/.archify/

# finalize/deliver 落在交付物旁边的收据：内容带着本机绝对路径（输入输出都是绝对路径），
# 属于本机产物；图的溯源已经写进 HTML 自身，不需要再提交一份
assets/diagrams/*.delivery.json
